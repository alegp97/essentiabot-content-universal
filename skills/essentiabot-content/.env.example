# OPTIONAL Instagram authentication. Leave blank for public extraction.
# Copy this template to a private location and pass --env-file explicitly.
# Never commit the populated file or paste credentials into chat.
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=

# OPTIONAL parent directory for isolated dependency caches.
# Leave blank to use the operating system temporary directory.
# Set this as a process environment variable; --env-file reads only Instagram keys.
ESSENTIABOT_CACHE_DIR=
